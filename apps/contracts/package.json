{
  "name": "contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "bunx hardhat build",
    "test": "bunx hardhat test",
    "typecheck": "bunx hardhat build && tsc --noEmit",
    "deploy:local": "bunx hardhat run scripts/deploy.ts",
    "deploy:testnet": "bunx hardhat run scripts/deploy.ts --network testnet",
    "seed:local": "bunx hardhat run scripts/seed.ts",
    "seed:testnet": "bunx hardhat run scripts/seed.ts --network testnet",
    "seed:testnet:lean": "SEED_PROFILE=lean bunx hardhat run scripts/seed.ts --network testnet",
    "probe:hedera:local": "bunx hardhat run scripts/probe-hedera.ts",
    "probe:hedera": "bunx hardhat run scripts/probe-hedera.ts --network testnet",
    "verify:testnet": "bunx hardhat verify --network testnet",
    "smoke:local": "pnpm run deploy:local && pnpm run seed:local && pnpm run probe:hedera:local",
    "console": "bunx hardhat console"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@truenft/shared": "workspace:*",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.15.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3"
  }
}
