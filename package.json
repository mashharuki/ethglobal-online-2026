{
  "name": "ethglobal-online-2026",
  "version": "1.0.0",
  "description": "TrueCollective - transfer-coupled rights runtime on Hedera (ETHGlobal ETHOnline 2026)",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check --write .",
    "ci": "pnpm exec biome ci . && pnpm knip && pnpm jscpd",
    "knip": "knip",
    "jscpd": "jscpd --config .jscpd.json ./apps ./packages",
    "web": "pnpm --filter web",
    "contracts": "pnpm --filter contracts",
    "gateway": "pnpm --filter gateway",
    "agent": "pnpm --filter agent",
    "subgraph": "pnpm --filter @subgraph",
    "cdk": "pnpm --filter cdk",
    "e2e": "pnpm --filter e2e",
    "shared": "pnpm --filter @truenft/shared",
    "openapi": "pnpm --filter @truenft/openapi",
    "audit:no-mocks": "AUDIT_STRICT=1 bash scripts/audit-no-mocks.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "jscpd": "^5.1.2",
    "knip": "^6.32.2",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
