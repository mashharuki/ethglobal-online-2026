<mxfile host="65bd71144e"><diagram name="TrueCollective Reference Architecture" id="truecollective-reference-architecture"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="TrueCollective — Transfer-Coupled Rights Runtime for NFTs   ·   Reference Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="32" y="14" width="1400" height="26" as="geometry"/></mxCell><mxCell id="grp2" value="Client  /  content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="32" y="60" width="296" height="300" as="geometry"/></mxCell><mxCell id="n3" value="MCP client&#10;(Claude Code / Codex)&#10;·&#10;apps/agent&#10;CI verification harness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="grp2"><mxGeometry x="18" y="38" width="260" height="130" as="geometry"/></mxCell><mxCell id="grp4" value="Cloudflare  —  Access Gateway  ·  apps/gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E4;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="336" y="60" width="664" height="300" as="geometry"/></mxCell><mxCell id="n5" value="Cloudflare Workers  (Hono)&#10;HTTP API   ·   MCP server /mcp  (discover · buy · decrypt)&#10;KeyGate release decision   ·   x402 settlement   ·   authz = on-chain reads every request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="grp4"><mxGeometry x="18" y="40" width="628" height="96" as="geometry"/></mxCell><mxCell id="n6" value="Workers KV  —  share_G (encrypted)&#10;Secrets Store  —  share_U · signing · operator key&#10;Hyperdrive → Postgres  —  bindings · consumption · audit  (non-authoritative)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="grp4"><mxGeometry x="18" y="156" width="318" height="110" as="geometry"/></mxCell><mxCell id="n7" value="Durable Objects&#10;ReceiptLock — consume serialisation (exactly-once)&#10;OperatorTxQueue — nonce, crash-safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="grp4"><mxGeometry x="352" y="156" width="294" height="110" as="geometry"/></mxCell><mxCell id="grp8" value="External services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#7D8FA6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="1030" y="60" width="300" height="226" as="geometry"/></mxCell><mxCell id="n9" value="Privy&#10;server wallet (MCP)&#10;+  embedded wallet (web)&#10;session signer + spend cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="grp8"><mxGeometry x="16" y="36" width="268" height="88" as="geometry"/></mxCell><mxCell id="n10" value="Blocky402  —  x402 facilitator (OSS)&#10;native HBAR · hedera:testnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="grp8"><mxGeometry x="16" y="138" width="268" height="74" as="geometry"/></mxCell><mxCell id="n11" value="IPFS / web3.storage&#10;encrypted content&#10;(ciphertext only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="grp2"><mxGeometry x="18" y="196" width="260" height="92" as="geometry"/></mxCell><mxCell id="grp12" value="AWS  —  Rights Graph   (apps/cdk · hackathon only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3E0;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="912" y="424" width="300" height="186" as="geometry"/></mxCell><mxCell id="n13" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="grp12"><mxGeometry x="122" y="34" width="48" height="48" as="geometry"/></mxCell><mxCell id="n14" value="self-hosted Graph Node&#10;graph-node · Postgres · IPFS  (EC2 + docker-compose)&#10;discovery / audit only — never gates access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="grp12"><mxGeometry x="16" y="92" width="268" height="80" as="geometry"/></mxCell><mxCell id="grp15" value="Hedera Testnet  (chainId 296)   —   the only source of authorization truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DEF3;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="336" y="424" width="552" height="186" as="geometry"/></mxCell><mxCell id="n16" value="RightsNFT  (ERC-721)&#10;accessEpoch = Owner Epoch&#10;bumped on every transfer&#10;policyHash · assetId · resourceHash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E1F5;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="grp15"><mxGeometry x="16" y="44" width="250" height="126" as="geometry"/></mxCell><mxCell id="n17" value="RightsRegistry&#10;licenseEpoch = License Epoch&#10;settleAndIssue{value} · consume(useIndex)&#10;Rights Receipts · revenue vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E1F5;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="grp15"><mxGeometry x="284" y="44" width="250" height="126" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Autonomous MCP flow&lt;/b&gt;   —   buy → decrypt, zero human steps&#10;&#10;❶   discover_assets — Workers queries the Rights Graph for published assets&#10;&#10;❷   buy_access — Workers quotes x402 (HTTP 402 + Rights Receipt terms),&#10;      reading the current Owner / License epochs from Hedera&#10;&#10;❸   Privy server wallet signs a native-HBAR transfer&#10;      (session signer + per-session spend cap; no raw key on Workers)&#10;&#10;❹   Workers settles the payment through the Blocky402 facilitator&#10;&#10;❺   OperatorTxQueue anchors it — RightsRegistry.settleAndIssue&#10;      → ReceiptIssued + RevenueAllocated (creator + current owner)&#10;&#10;❻   decrypt_content — Workers re-reads ownerOf / receiptStatus from Hedera&#10;      (authorization is never taken from cache or the subgraph)&#10;&#10;❼   ReceiptLock serialises the use — RightsRegistry.consume(receiptHash, useIndex)&#10;      → ReceiptConsumed  (exactly-once, even under 20-way replay)&#10;&#10;❽   KeyGate releases the blinded key share from KV (share_G) + Secrets (share_U)&#10;&#10;❾   MCP client rebuilds K = share_G ⊕ share_U, fetches ciphertext from IPFS,&#10;      decrypts AES-256-GCM locally&#10;&#10;❿   Rights Graph indexes the new events — discovery / audit only&#10;&#10;The browser owner path (apps/web) is the same shape without ❷–❺: prove ownership,&#10;re-read accessEpoch, release the share." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B7C3;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingTop=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="1372" y="60" width="612" height="548" as="geometry"/></mxCell><mxCell id="n19" value="solid = synchronous critical path        dashed = async settlement or discovery (non-authoritative)        Owner Epoch and License Epoch are versioned independently — a transfer bumps only the Owner Epoch." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="32" y="624" width="1500" height="22" as="geometry"/></mxCell><mxCell id="e20" value="❶ ❻ ❽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#232F3E;strokeWidth=2;fontSize=14;fontStyle=1;" edge="1" source="n3" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="❶" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#545B64;fontSize=14;fontStyle=1;dashed=1;strokeColor=#8894A6;" edge="1" source="n5" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="❷ ❻" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#232F3E;strokeWidth=2;fontSize=14;fontStyle=1;" edge="1" source="n5" target="n16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="❸ ❹" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#232F3E;strokeWidth=2;fontSize=14;fontStyle=1;" edge="1" source="n5" target="grp8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="❺ ❼" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#232F3E;strokeWidth=2;fontSize=14;fontStyle=1;" edge="1" source="n7" target="n17" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#545B64;fontSize=14;fontStyle=1;" edge="1" source="n5" target="n7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="❽" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#545B64;fontSize=14;fontStyle=1;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="❾" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#545B64;fontSize=14;fontStyle=1;" edge="1" source="n3" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="❿" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#545B64;fontSize=14;fontStyle=1;dashed=1;strokeColor=#8894A6;" edge="1" source="n17" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;strokeColor=#545B64;fontSize=14;fontStyle=1;" edge="1" source="n16" target="n17" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>