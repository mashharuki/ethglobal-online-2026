# TrueCollective - environment variables (copy to .env / apps/gateway/.dev.vars as needed)
# Payment asset is native HBAR (constitution v1.3.0). There are no USDC / HTS token variables.

# --- Hedera Testnet (chainId 296) ---
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Operator key used by apps/contracts deploy/seed and by the gateway for `consume` / `bumpLicenseEpoch`.
# Prefer `npx hardhat keystore set HEDERA_OPERATOR_KEY` over a plaintext .env for the contracts workspace.
HEDERA_OPERATOR_KEY=

# --- x402 facilitator (Blocky402, Hedera "AI & Agentic Payments" track requirement) ---
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
PAYMENT_ASSET=native
# primary | fallback | custodial - settlement rail selected by the day1 probe (research.md R-2 / R-2a)
SETTLEMENT_MODE=primary

# --- AI (apps/agent CI harness) ---
ANTHROPIC_API_KEY=

# --- Gateway (Cloudflare Workers) ---
# Direct origin Postgres connection string used by drizzle-kit and `wrangler hyperdrive create`.
# Keep this server-side only; never expose it through Worker vars or frontend environment values.
DATABASE_URL=
# Legacy planning variable retained for compatibility. Runtime DB access uses the HYPERDRIVE binding.
HYPERDRIVE_URL=
GATEWAY_URL=http://localhost:8787

# --- Content storage ---
# Required by seed:testnet for public IPFS uploads (Pinata pinFileToIPFS permission).
# Read from process.env, not Hardhat keystore; export it before running the seed command.
PINATA_JWT=
WEB3_STORAGE_TOKEN=

# --- Rights Graph (self-hosted Graph Node, apps/cdk) ---
GRAPH_NODE_HOST=
GRAPH_NODE_ADMIN=
GRAPH_NODE_IPFS=
SUBGRAPH_URL=

# --- AWS (apps/cdk, hackathon-duration-only infra) ---
AWS_REGION=ap-northeast-1

# --- Privy ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=
