{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "compile": {
      "inputs": ["contracts/**", "hardhat.config.ts"],
      "outputs": ["artifacts/**", "cache/**"]
    },
    "generate": {
      "inputs": ["openapi.yaml"],
      "outputs": ["src/types.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^compile", "^generate"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^compile", "^generate"]
    },
    "test": {
      "dependsOn": ["^build", "^compile", "^generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
